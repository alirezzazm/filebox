# کپی کن به .env و مقادیر را عوض کن:  cp .env.example .env

# رمز پنل دانلود (حتماً عوضش کن)
ADMIN_PASSWORD=یک-رمز-قوی-بگذار

# رمز آپلود — اگر خالی بماند، هرکسی که لینک را دارد می‌تواند آپلود کند و چت کند
UPLOAD_PASSWORD=

# حداکثر حجم هر فایل به مگابایت
MAX_FILE_MB=2048

# مدت اعتبار ورود به پنل (ساعت)
SESSION_HOURS=12

# توکن تانل کلادفلر (از داشبورد Zero Trust > Tunnels کپی کن)
TUNNEL_TOKEN=
