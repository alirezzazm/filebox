# کپی کن به .env و مقادیر را عوض کن:  cp .env.example .env

# رمز پنل دانلود (حتماً عوضش کن)
ADMIN_PASSWORD=یک-رمز-قوی-بگذار

# رمز آپلود — اگر خالی بماند، هرکسی که لینک را دارد می‌تواند آپلود کند و چت کند
UPLOAD_PASSWORD=

# پورت روی هاست (فقط 127.0.0.1؛ nginx یا تانل جلوی آن است)
FILEBOX_PORT=8080

# حداکثر حجم هر فایل به مگابایت
MAX_FILE_MB=2048

# سقف فضای روی همین سرور، و کف فضای آزاد دیسک
STORAGE_QUOTA_GB=5
MIN_FREE_DISK_GB=2

# ---- ذخیره روی گیت‌هاب (اختیاری) ----
# ریپوی خصوصی که فایل‌ها (به صورت release asset) و db.json در آن نگه داشته می‌شوند.
# اگر GITHUB_TOKEN یا GITHUB_REPO خالی باشد، همه چیز روی همین سرور می‌ماند.
# توکن: fine-grained، فقط همین یک ریپو، دسترسی Contents: Read and write
GITHUB_TOKEN=
GITHUB_REPO=alirezzazm/filebox-data
GITHUB_BRANCH=main
GITHUB_QUOTA_GB=20
# مقصد پیش‌فرض آپلود: github یا local (از پنل ادمین هم عوض می‌شود)
STORAGE_BACKEND=github
# هر چند ثانیه db.json با ریپو همگام شود
DB_SYNC_SECONDS=20

# مدت اعتبار ورود به پنل (ساعت)
SESSION_HOURS=12

# توکن تانل کلادفلر (از داشبورد Zero Trust > Tunnels کپی کن)
TUNNEL_TOKEN=
